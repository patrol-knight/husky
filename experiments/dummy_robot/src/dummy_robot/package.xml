<?xml version="1.0"?>
<package format="3">
  <name>dummy_robot</name>
  <version>0.4.0</version>
  <description>
    Lanelet-aware fake Husky: plans a route across the lanelet2 map to a goal
    on /planning/mission_planning/goal and drives along it at a constant speed,
    publishing the Autoware and Clearpath topics state_machine reads.
  </description>

  <maintainer email="devnull@example.com">zenoh_bridge maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>autoware_adapi_v1_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>lanelet2_core</depend>
  <depend>lanelet2_io</depend>
  <depend>lanelet2_projection</depend>
  <depend>lanelet2_routing</depend>
  <depend>lanelet2_traffic_rules</depend>
  <depend>yaml-cpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
